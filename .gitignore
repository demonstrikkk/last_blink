# Editor / OS
.vscode/
.idea/
Thumbs.db
Desktop.ini

# Downloaded archives are preserved on purpose, but temporary extraction
# scratch space outside assets/raw must never be committed.
tmp/

# Extracted pack contents are derivable from the committed archives in
# assets/raw/*.zip via tools/assets/download/*.py, so they are not versioned.
assets/raw/extracted/
