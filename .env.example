# Server-only configuration. Never prefix private values with VITE_ and never
# commit a populated .env file. The Vite dev server never reads these values;
# only `npm run server` and `npm run db:migrate` do.
DATABASE_URL=postgresql://user:password@host:5433/yugabyte
# Filesystem path to the Yugabyte Cloud root CA (not the PEM itself).
DATABASE_SSL_CA=C:\path\to\root.crt
MEKO_ENDPOINT_URL=https://mcp.mekodata.ai/mcp
MEKO_API_KEY=
MEKO_DATAPACK_ID=
MEKO_TIMEOUT_MS=12000
MEKO_OFFLINE_ONLY=false
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MODEL_GATEWAY_TIMEOUT_MS=8000
MODEL_GATEWAY_MAX_CONCURRENCY=4
MODEL_GATEWAY_RPM=30
MODEL_GATEWAY_TPM=12000
SESSION_SECRET=replace-with-at-least-32-random-characters
PORT=8787
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=120
MAX_BODY_BYTES=262144
TOKEN_TTL_MS=43200000
# The Vite client discovers the API base URL at build time. Leave empty when
# the server is same-origin or when using the dev proxy.
VITE_API_BASE_URL=
