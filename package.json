{
  "name": "the-last-blink",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Last Blink: Second Settlement — deterministic game engine foundation",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "node --env-file-if-exists=.env --experimental-strip-types src/server/httpServer.ts",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types src/server/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "phaser": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
